  create view "trivial_pursuit"."main"."int_questions__dbt_tmp" as (
    

SELECT
    question,
    category,
    difficulty,
    type,
    incorrect_answers,
    correct_answer,
    ai_answer,
    ai_correct,
    response_time,
    ai_model,
    source_file,

    -- Vérifier si le modèle n'a pas répondu
    CASE
        WHEN ai_answer IS NULL OR TRIM(ai_answer) = ''
        THEN TRUE
        ELSE FALSE
    END AS is_unanswered,

    -- Classer le résultat de la réponse
    CASE
        WHEN ai_correct = TRUE THEN 'Correcte'
        WHEN ai_correct = FALSE THEN 'Incorrecte'
        ELSE 'Non évaluée'
    END AS answer_status,

    -- Nettoyer le temps de réponse
    CASE
        WHEN response_time IS NULL OR response_time < 0
        THEN NULL
        ELSE response_time
    END AS clean_response_time

FROM "trivial_pursuit"."main"."stg_questions"
  );

